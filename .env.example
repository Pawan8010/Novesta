# APP_URL: The live HTTPS domain where Novesta is deployed (Hostinger / VPS / Cloud Run).
APP_URL="https://novesta.online"

# Hostinger Business Email SMTP (Recommended primary email transport for hello@novesta.online)
# Sends payment confirmation receipts to customers AND notifications to hello@novesta.online.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="hello@novesta.online"
SMTP_PASS=""
SMTP_FROM="Novesta <hello@novesta.online>"

# Optional Resend Email API fallback (https://resend.com)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Novesta <hello@novesta.online>"
CONTACT_TO_EMAIL="hello@novesta.online"
FOUNDER_BACKUP_EMAIL="novesta111@gmail.com"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform JavaScript API key (HTTP-referrer restricted).
VITE_GOOGLE_MAPS_API_KEY=""

# Optional SEO & Analytics overrides (also configurable in src/config/site.ts)
VITE_GA4_MEASUREMENT_ID=""
VITE_GSC_VERIFICATION=""

# Founder-only Careers, Leads & Payments Portal Auth
FOUNDER_ADMIN_KEY=""
