# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Optional API key from https://resend.com to deliver contact/career emails.
# Without this key, submissions are validated and logged in preview mode.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Weblance Website <onboarding@resend.dev>"
CONTACT_TO_EMAIL="novesta111@gmail.com"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform JavaScript API key (HTTP-referrer restricted).
VITE_GOOGLE_MAPS_API_KEY=""

# Optional SEO & Analytics overrides (also configurable in src/config/site.ts)
VITE_GA4_MEASUREMENT_ID=""
VITE_GSC_VERIFICATION=""

# Founder-only Careers & Leads Admin Auth (set FOUNDER_ADMIN_KEY in .env or host env vars)
FOUNDER_ADMIN_KEY=""
FOUNDER_EMAILS="rajputpavan168@gmail.com,rajputpawan9765@gmail.com,novesta111@gmail.com"

# Razorpay Payment Gateway & Webhook Verification (server-side only; never commit live secrets)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

